# Copy to `.env` and fill with your own Supabase project values.
# Only EXPO_PUBLIC_* variables are exposed to the app bundle.
# NEVER put the service_role key here or anywhere in the Expo app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key
